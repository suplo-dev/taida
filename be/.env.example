APP_NAME=Taida
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=be
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# Nuxt frontend origins allowed to send credentialed requests (comma separated).
FRONTEND_URLS=http://localhost:3000,http://localhost:3001
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:3001,127.0.0.1:3001

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Site công khai là HTML tĩnh, nên nội dung sửa trong CMS chỉ hiện sau khi sinh
# lại site. Bật cờ này để mỗi lần biên tập tự hẹn một lần build trên GitHub
# Actions. Để trống token là tắt — khi đó phải tự bấm "Run workflow".
PUBLISH_ENABLED=false
PUBLISH_GITHUB_TOKEN=
PUBLISH_GITHUB_REPOSITORY=
PUBLISH_GITHUB_WORKFLOW=deploy.yml
PUBLISH_GITHUB_REF=main

# Giây chờ kể từ lần sửa cuối rồi mới gọi build. Mỗi lần lưu đặt lại đồng hồ
# này, nên sửa liên tiếp nhiều thứ chỉ tạo một lần build.
PUBLISH_QUIET_PERIOD=90
# Giây tối thiểu giữa hai lần build, chặn việc nhập liệu liên tục làm hàng chục
# build xếp hàng. Nên để lớn hơn thời gian một lần build chạy xong.
PUBLISH_COOLDOWN=300
