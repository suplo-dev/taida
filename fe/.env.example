# Cấu hình cho máy dev. Copy thành `.env`.
#
# `nuxt dev` đọc file này. `pnpm generate` thì KHÔNG — nó đọc `.env.production`,
# để chạy build cho production không vô tình lấy nhầm địa chỉ localhost.
#
# Cả hai giá trị đều được nướng vào bundle lúc build chứ không đọc lúc chạy.

# Địa chỉ API mà trình duyệt gọi tới.
NUXT_PUBLIC_API_BASE=http://localhost:8000

# Địa chỉ site, dùng cho canonical, hreflang, sitemap và ảnh chia sẻ.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Chỉ dùng khi chạy SSR: địa chỉ API mà Nitro gọi từ phía server, có thể là địa
# chỉ nội bộ. Bản tĩnh không dùng tới.
# NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000
