# Cấu hình dùng khi sinh site cho production. Copy thành `.env.production`.
#
#     cp .env.production.example .env.production
#     pnpm generate
#
# `pnpm generate` đọc đúng file này (`--dotenv .env.production` trong
# package.json), nên không cần truyền biến trên dòng lệnh nữa. `pnpm dev` không
# đụng tới nó, vẫn dùng `.env`.
#
# Hai giá trị này được nướng thẳng vào từng file HTML sinh ra. Sai một cái thì
# site vẫn build xong và vẫn chạy, chỉ là gọi nhầm API hoặc khai báo sai địa chỉ
# cho Google — không có lỗi nào báo.
#
# API phải đang chạy và có dữ liệu trong lúc build: mỗi trang được dựng bằng
# cách gọi vào đó.

NUXT_PUBLIC_API_BASE=https://api.taida.vn
NUXT_PUBLIC_SITE_URL=https://www.taida.vn
