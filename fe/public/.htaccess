# Cấu hình Apache cho bản site tĩnh (`pnpm generate`) chạy trên shared hosting.
#
# File nằm trong `public/` để tự được copy vào output mỗi lần build. Quên mang
# nó lên server thì site vẫn chạy — chỉ là không nén, không cache, và /admin
# hỏng khi tải lại trang. Không có gì báo lỗi, chỉ mất khoảng 10 điểm Lighthouse.
#
# Nitro bỏ qua file này, nên bản SSR không bị ảnh hưởng.
#
# Ba việc nó làm:
#   1. Trả bản .br/.gz đã nén sẵn — nếu mất, HTML từ 8 KB phồng lên 41 KB.
#   2. Cache dài cho tài nguyên có hash, cache ngắn cho HTML.
#   3. Fallback SPA cho /admin — các route con của trang quản trị chỉ tồn tại
#      trong trình duyệt, không có file tương ứng trên đĩa.

DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Bản nén sẵn -------------------------------------------------------
    # Nuxt ghi kèm .br và .gz cho mọi tài nguyên. Trả thẳng file đó rẻ hơn nhiều
    # so với để mod_deflate nén lại từng request, và nén ở mức cao hơn.
    RewriteCond %{HTTP:Accept-Encoding} br
    RewriteCond %{REQUEST_FILENAME}.br -f
    RewriteRule ^(.*)$ $1.br [QSA,L,E=ASSET_BR:1]

    RewriteCond %{HTTP:Accept-Encoding} gzip
    RewriteCond %{REQUEST_FILENAME}.gz -f
    RewriteRule ^(.*)$ $1.gz [QSA,L,E=ASSET_GZ:1]

    # --- Fallback cho trang quản trị ---------------------------------------
    # /admin/services/12 không có file thật; nạp vỏ SPA để router phía trình
    # duyệt tự xử lý. Chỉ áp dụng cho /admin — trang công khai mà không có file
    # thì phải là 404 thật, nếu không Google sẽ index vô số trang rỗng.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^admin(/.*)?$ /200.html [L]
</IfModule>

<IfModule mod_headers.c>
    # RewriteRule ở trên đổi đường dẫn nhưng không tự khai báo mã hoá.
    <FilesMatch "\.br$">
        Header set Content-Encoding br
        Header append Vary Accept-Encoding
    </FilesMatch>
    <FilesMatch "\.gz$">
        Header set Content-Encoding gzip
        Header append Vary Accept-Encoding
    </FilesMatch>

    <IfModule mod_setenvif.c>
        # Kể cả khi không rewrite, phía cache trung gian vẫn cần biết nội dung
        # thay đổi theo Accept-Encoding.
        Header append Vary Accept-Encoding env=!ASSET_BR
    </IfModule>

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Trang quản trị không có việc gì xuất hiện trên kết quả tìm kiếm.
    <FilesMatch "^200\.html(\.br|\.gz)?$">
        Header always set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    # Không có dòng này Apache nhìn đuôi .br/.gz và trả về application/x-gzip.
    RemoveType .br .gz
    AddType text/html .html
    AddType text/css .css
    AddType application/javascript .js .mjs
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType application/xml .xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # Mọi mẫu dưới đây phải chấp nhận cả đuôi .br/.gz. Khi rewrite trả bản nén
    # sẵn, tên file thật là `entry.abc123.css.br`, và FilesMatch so với tên file
    # thật chứ không phải URL — thiếu phần `(\.br|\.gz)?` thì đúng những file
    # được phục vụ nhiều nhất lại là những file không nhận được luật cache nào.

    # Tên file có hash nội dung, đổi nội dung là đổi tên — giữ được vĩnh viễn.
    <FilesMatch "\.(js|mjs|css|woff2)(\.br|\.gz)?$">
        ExpiresDefault "access plus 1 year"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(jpg|jpeg|png|webp|avif|gif|ico|svg)(\.br|\.gz)?$">
        ExpiresDefault "access plus 30 days"
    </FilesMatch>

    # HTML phải kiểm tra lại mỗi lần, nếu không nội dung mới build sẽ không tới
    # được người dùng cũ.
    <FilesMatch "\.html(\.br|\.gz)?$">
        ExpiresDefault "access plus 0 seconds"
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
