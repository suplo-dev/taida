# Cấu hình Apache khi tên miền được trỏ thẳng vào thư mục `fe/` của repo.
#
# Thư mục này là **mã nguồn**. Site nằm ở `.output/public/`, do `pnpm generate`
# sinh ra và được commit để server chỉ cần `git pull`.
#
# Đây là file .htaccess duy nhất của tên miền này. Trước đây còn một file nữa
# trong `public/`, đi kèm bản build — nhưng .htaccess con **ghi đè** luật
# rewrite của cha thay vì cộng thêm, nên thư mục `public/` khi đó thoát khỏi
# mọi luật ở đây và trả thẳng file nguồn ra ngoài. Giữ đúng một file là cách
# duy nhất không phải nhớ luật ưu tiên ấy.

Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- 1. Không cho gọi thẳng /.output/... từ bên ngoài --------------------
    #
    # Nếu để mở, mỗi trang có hai địa chỉ (`/dich-vu/` và
    # `/.output/public/dich-vu/`) và Google chấm site trùng lặp. REDIRECT_STATUS
    # rỗng nghĩa là request đến thẳng từ trình duyệt; với rewrite nội bộ ở bước
    # 3 thì Apache đã đặt biến này, nên luồng bên trong không bị chặn.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^\.output/ - [F,L]

    # --- 2. Fallback SPA cho trang quản trị ---------------------------------
    #
    # `/admin/services/12` chỉ tồn tại trong trình duyệt, không có file tương
    # ứng. Chỉ áp dụng cho /admin — trang công khai không có file thì phải là
    # 404 thật, nếu không Google sẽ index vô số trang rỗng.
    RewriteCond %{DOCUMENT_ROOT}/.output/public%{REQUEST_URI} !-f
    RewriteCond %{DOCUMENT_ROOT}/.output/public%{REQUEST_URI} !-d
    RewriteRule ^admin(/.*)?$ .output/public/200.html [L]

    # --- 3. Đưa mọi request vào thư mục build -------------------------------
    #
    # Nhờ bước này mà `nuxt.config.ts`, `package.json`, `app/`, `server/`,
    # `.env.production`… tự động không với tới được: chúng không có bản sao nào
    # bên trong `.output/public/`.
    RewriteCond %{REQUEST_URI} !^/\.output/public/
    RewriteRule ^(.*)$ .output/public/$1 [L]

    # --- 4. Bản nén sẵn ------------------------------------------------------
    #
    # Chạy sau bước 3, khi đường dẫn đã nằm trong thư mục build. Với thư mục,
    # mod_dir tìm ra index.html rồi chuyển hướng nội bộ, và luật này chạy lại
    # trên đúng file đó — nên trang HTML cũng được nén.
    RewriteCond %{HTTP:Accept-Encoding} br
    RewriteCond %{REQUEST_FILENAME}.br -f
    RewriteRule ^(.*)$ $1.br [QSA,L]

    RewriteCond %{HTTP:Accept-Encoding} gzip
    RewriteCond %{REQUEST_FILENAME}.gz -f
    RewriteRule ^(.*)$ $1.gz [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    # Rewrite ở bước 4 đổi tên file nhưng không tự khai báo mã hoá.
    <FilesMatch "\.br$">
        Header set Content-Encoding br
        Header append Vary Accept-Encoding
    </FilesMatch>
    <FilesMatch "\.gz$">
        Header set Content-Encoding gzip
        Header append Vary Accept-Encoding
    </FilesMatch>

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Trang quản trị không có việc gì xuất hiện trên kết quả tìm kiếm.
    <FilesMatch "^200\.html(\.br|\.gz)?$">
        Header always set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    # Không có dòng này Apache nhìn đuôi .br/.gz và trả về application/x-gzip.
    RemoveType .br .gz
    AddType text/html .html
    AddType text/css .css
    AddType application/javascript .js .mjs
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType application/xml .xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # Mọi mẫu dưới đây phải chấp nhận cả đuôi .br/.gz. Khi rewrite trả bản nén
    # sẵn, tên file thật là `entry.abc123.css.br`, và FilesMatch so với tên file
    # thật chứ không phải URL — thiếu phần `(\.br|\.gz)?` thì đúng những file
    # được phục vụ nhiều nhất lại là những file không nhận được luật cache nào.

    # Tên file có hash nội dung, đổi nội dung là đổi tên — giữ được vĩnh viễn.
    <FilesMatch "\.(js|mjs|css|woff2)(\.br|\.gz)?$">
        ExpiresDefault "access plus 1 year"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(jpg|jpeg|png|webp|avif|gif|ico|svg)(\.br|\.gz)?$">
        ExpiresDefault "access plus 30 days"
    </FilesMatch>

    # HTML phải kiểm tra lại mỗi lần, nếu không nội dung mới build sẽ không tới
    # được người dùng cũ.
    <FilesMatch "\.html(\.br|\.gz)?$">
        ExpiresDefault "access plus 0 seconds"
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

# Đường dẫn công khai, không phải `/.output/public/404.html`: đường dẫn nội bộ
# bị chính luật ở bước 1 chặn lại, Apache không đọc được trang lỗi và lặng lẽ
# quay về trang 404 mặc định của nó. Ở dạng này thì nó đi qua bước 3 như mọi
# request khác.
ErrorDocument 404 /404.html

# Lớp cuối, không phụ thuộc mod_rewrite: nếu hosting không bật module đó thì mọi
# luật ở trên im lặng biến mất, và `.env.production` nằm ngay trong thư mục được
# phục vụ.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "^(nuxt\.config\.ts|package(-lock)?\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|tsconfig\.json)$">
    Require all denied
</FilesMatch>
