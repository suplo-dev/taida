# Copy to /var/www/taida/api/shared/.env, fill in, then `chmod 600`.
# Generate APP_KEY once with: php artisan key:generate --show

APP_NAME=Taida
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.taida.vn

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taida
DB_USERNAME=taida
DB_PASSWORD=

# --- Cookie auth for the Nuxt admin SPA -------------------------------------
# These four must agree or login succeeds and every following request 401s.
# The leading dot lets www.taida.vn and api.taida.vn share one session cookie.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.taida.vn
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Origins allowed to send credentialed requests (config/cors.php).
FRONTEND_URLS=https://www.taida.vn,https://taida.vn
# Hosts Sanctum treats as "the same app" — no scheme, port only if non-standard.
SANCTUM_STATEFUL_DOMAINS=www.taida.vn,taida.vn

# PHP-FPM only ever talks to nginx on loopback. Without this the request looks
# like plain HTTP and SESSION_SECURE_COOKIE silently drops every cookie.
TRUSTED_PROXIES=127.0.0.1,::1

FILESYSTEM_DISK=public
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@taida.vn"
MAIL_FROM_NAME="${APP_NAME}"

# Tự sinh lại site tĩnh sau khi biên tập. Cần cron chạy `php artisan
# schedule:run` mỗi phút, xem deploy/shared-hosting/README.md mục 7.
# Token là fine-grained PAT, chỉ cần quyền `actions: write` trên đúng repo này.
PUBLISH_ENABLED=true
PUBLISH_GITHUB_TOKEN=
PUBLISH_GITHUB_REPOSITORY=<chu-so-huu>/<ten-repo>
PUBLISH_GITHUB_WORKFLOW=deploy.yml
PUBLISH_GITHUB_REF=main

# Giây chờ kể từ lần sửa cuối rồi mới gọi build; mỗi lần lưu đặt lại đồng hồ này
# nên một đợt biên tập chỉ tạo một lần build. Hạ xuống thì nội dung lên nhanh
# hơn nhưng dễ sinh nhiều build thừa.
PUBLISH_QUIET_PERIOD=90
# Giây tối thiểu giữa hai lần build. Nên để lớn hơn thời gian workflow chạy xong
# (hiện khoảng 2–3 phút), nếu không build sau sẽ chồng lên build trước.
PUBLISH_COOLDOWN=300
