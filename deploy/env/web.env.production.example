# Copy to /var/www/taida/web/shared/.env, fill in, then `chmod 600`.
#
# systemd reads this file directly (EnvironmentFile=), so it must be plain
# KEY=value: no `export`, no quotes unless they are part of the value, no
# shell expansion.
#
# IMPORTANT: NUXT_PUBLIC_* values are baked into the client bundle at build
# time, so CI needs them too (see .github/workflows/deploy.yml). The copies
# here only cover the server side; changing one means rebuilding, not just
# restarting.

NODE_ENV=production

# Where the Nitro server listens. nginx proxies to this and nothing else
# should be able to reach it — keep it on loopback.
NITRO_HOST=127.0.0.1
NITRO_PORT=3000

# API base used by SSR (server-side $fetch). Loops back out through nginx,
# which is what gives it a valid TLS certificate for api.taida.vn.
NUXT_API_BASE=https://api.taida.vn

# API base used by the browser, including the admin SPA.
NUXT_API_BASE=https://api.taida.vn

# Canonical origin. Feeds canonical/hreflang links, the sitemap, and OG image
# URLs — a wrong value here is an SEO bug, not a runtime error.
NUXT_SITE_URL=https://www.taida.vn
