[Unit]
Description=Taida — Nuxt 4 SSR (Nitro node server)
Documentation=file:///var/www/taida/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=taida
Group=taida

# `current` is a symlink swapped by deploy-web.sh. WorkingDirectory follows it
# at start time, so a restart is what actually activates a new release.
WorkingDirectory=/var/www/taida/web/current
EnvironmentFile=/var/www/taida/web/shared/.env
Environment=NODE_ENV=production
Environment=NITRO_PORT=3000
Environment=NITRO_HOST=127.0.0.1

ExecStart=/usr/bin/node /var/www/taida/web/current/.output/server/index.mjs

Restart=always
RestartSec=3
# Give up on a boot loop rather than hammering the box forever.
StartLimitBurst=5
StartLimitIntervalSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=taida-web

# The process only ever reads its own release directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/taida/web/shared

[Install]
WantedBy=multi-user.target
